# Supabase
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxxxxxxx

# VK Mini App
VITE_VK_APP_ID=00000000

# --- Только для supabase/functions (Edge Functions), НЕ для фронтенда ---
# Задаются через: supabase secrets set VK_CLIENT_SECRET=... и т.д.
# VK_CLIENT_SECRET=защищённый ключ приложения из VK
# VK_SERVICE_TOKEN=сервисный ключ доступа приложения из VK
# SUPABASE_SERVICE_ROLE_KEY=service_role ключ проекта Supabase (Settings -> API)
